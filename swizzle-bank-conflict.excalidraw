    {
      "id": "swizzle-left-formula",
      "type": "text",
      "x": 80,
      "y": 210,
      "width": 520,
      "height": 56,
      "text": "word_addr = lane × 32\nbank = word_addr % 32 = 0",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "seed": 2301,
      "version": 1,
      "versionNonce": 23001,
      "isDeleted": false,
      "groupIds": [],
      "boundElementIds": [],
      "updated": 1,
      "link": null,
      "locked": false
    },
    {
      "id": "swizzle-right-formula",
      "type": "text",
      "x": 750,
      "y": 210,
      "width": 540,
      "height": 56,
      "text": "word_addr′ = word_addr XOR lane\nbank = word_addr′ % 32 = lane",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
